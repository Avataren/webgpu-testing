// @editor
// Simple Text Editor Plugin
// Demonstrates multiline text editing and file I/O

pub fn on_created(self_entity) {
    log_info("Simple Text Editor plugin created");

    // Initialize state using set_string to match get_string usage
    set_string("text_content", "");
    set_string("file_path", "examples/scripts/notes.txt");
    set_string("status_message", "Ready");
}

pub fn on_ui(ui) {
    ui.heading("Simple Text Editor");

    // Get current state - all strings now
    let file_path = get_string("file_path", "examples/scripts/notes.txt");
    let status = get_string("status_message", "Ready");

    // File path input
    ui.label("File path:");
    let new_path = ui.text_edit("file_path", file_path);
    set_string("file_path", new_path);

    // Buttons
    ui.separator();

    if ui.button("Load File") {
        let path = get_string("file_path", "");
        let content = read_file(path);
        if content.starts_with("ERROR") {
            set_string("status_message", content);
        } else {
            set_string("text_content", content);
            let path_for_msg = get_string("file_path", "");
            set_string("status_message", `Loaded from ${path_for_msg}`);
        }
    }

    if ui.button("Save File") {
        let path = get_string("file_path", "");
        let content = get_string("text_content", "");
        let error = write_file(path, content);
        if error == "" {
            let path_for_msg = get_string("file_path", "");
            set_string("status_message", `Saved to ${path_for_msg}`);
        } else {
            set_string("status_message", error);
        }
    }

    if ui.button("New File") {
        set_string("text_content", "");
        set_string("status_message", "New file");
    }

    // Status message
    ui.separator();
    ui.label(status);
    ui.separator();

    // Multiline text editor
    ui.label("Content:");
    let content = get_string("text_content", "");
    let new_content = ui.text_edit_multiline("content", content, None, Some(400.0));
    set_string("text_content", new_content);
}
