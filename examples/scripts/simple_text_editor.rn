// @editor
// Simple Text Editor Plugin
// Demonstrates multiline text editing and file I/O

pub fn on_created(self_entity) {
    log_info("Simple Text Editor plugin created");

    // Initialize state
    set_state("text_content", "");
    set_state("file_path", "examples/scripts/notes.txt");
    set_state("status_message", "Ready");
}

pub fn on_ui(self_entity, ui) {
    ui.heading("Simple Text Editor");

    let file_path = get_state("file_path", "examples/scripts/notes.txt");
    let text_content = get_state("text_content", "");
    let status = get_state("status_message", "Ready");

    // File path input
    ui.label("File path:");
    let new_path = ui.text_edit("file_path", file_path);
    if new_path != file_path {
        set_state("file_path", new_path);
    }

    // Buttons
    ui.separator();

    if ui.button("Load File") {
        let content = read_file(new_path);
        if content.starts_with("ERROR") {
            set_state("status_message", content);
        } else {
            set_state("text_content", content);
            set_state("status_message", `Loaded from ${new_path}`);
        }
    }

    if ui.button("Save File") {
        let error = write_file(new_path, text_content);
        if error == "" {
            set_state("status_message", `Saved to ${new_path}`);
        } else {
            set_state("status_message", error);
        }
    }

    if ui.button("New File") {
        set_state("text_content", "");
        set_state("status_message", "New file");
    }

    // Status message
    ui.separator();
    ui.label(status);
    ui.separator();

    // Multiline text editor
    ui.label("Content:");
    let new_content = ui.text_edit_multiline("content", text_content, None, Some(400.0));
    if new_content != text_content {
        set_state("text_content", new_content);
    }
}
