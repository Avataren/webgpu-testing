// @tool
// This script runs in editor mode (when dt == 0)
//
// Example of an editor tool script that logs messages in the editor

pub fn on_created(self_entity) {
    log_info("Editor tool created! This runs in editor mode.");
}

pub fn update(self_entity, dt) {
    // In editor mode, dt will be 0
    // In play mode, dt will be > 0

    if dt == 0.0 {
        // We're in editor mode
        log_debug("Editor tool update - editor mode");
    } else {
        // We're in play mode
        log_info(`Editor tool update - play mode (dt: ${dt})`);
    }
}

