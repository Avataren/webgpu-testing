// @editor
// Script Editor Plugin
// A full-featured script editor for editing RuneScript files

pub fn on_created(self_entity) {
    log_info("Script Editor plugin created");

    // Initialize state with individual keys (avoids Value ownership issues)
    set_f64("selected_index", -1.0);
    set_string("current_content", "");
    set_string("current_path", "");
    set_string("status_message", "Ready");
    set_bool("is_dirty", false);
    set_bool("needs_refresh", true);
}

pub fn on_ui(ui) {
    // Load scripts on first render or when requested
    let needs_refresh = get_bool("needs_refresh", true);
    if needs_refresh {
        refresh_script_list();
        return;
    }

    ui.heading("Script Editor");

    // Toolbar
    if ui.button("Refresh Scripts") {
        refresh_script_list();
        return;
    }

    if ui.button("Save") {
        let current_path = get_string("current_path", "");
        if current_path != "" {
            let current_content = get_string("current_content", "");
            let error = write_file(current_path, current_content);
            if error == "" {
                let path_for_msg = get_string("current_path", "");
                set_string("status_message", `Saved ${path_for_msg}`);
                set_bool("is_dirty", false);
            } else {
                set_string("status_message", error);
            }
        } else {
            set_string("status_message", "No script selected");
        }
        return;
    }

    if ui.button("Revert") {
        let current_path = get_string("current_path", "");
        let is_dirty = get_bool("is_dirty", false);

        if current_path != "" && !is_dirty {
            set_string("status_message", "No changes to revert");
        } else if current_path != "" {
            let content = read_file(current_path);
            if !content.starts_with("ERROR") {
                set_string("current_content", content);
                set_bool("is_dirty", false);
                let path_for_msg = get_string("current_path", "");
                set_string("status_message", `Reverted ${path_for_msg}`);
            } else {
                set_string("status_message", content);
            }
        }
        return;
    }

    ui.separator();

    // Status bar
    let status_message = get_string("status_message", "Ready");
    let is_dirty = get_bool("is_dirty", false);
    let status_text = if is_dirty {
        `${status_message} [Modified]`
    } else {
        status_message
    };
    ui.label(status_text);

    let current_path = get_string("current_path", "");
    if current_path != "" {
        ui.label(`Editing: ${current_path}`);
    }

    ui.separator();

    // Script list
    ui.label("Scripts in scene:");

    let scripts = get_all_script_entities();

    if scripts.len() == 0 {
        ui.label("  No scripts found");
    } else {
        for i in 0..scripts.len() {
            let script = scripts[i];
            let entity_name = get_entity_name(script.entity);
            let button_label = `${entity_name} (${script.source_type}): ${script.source_path}`;

            if ui.button(button_label) {
                if script.source_type == "file" {
                    let path = script.source_path;
                    let content = read_file(path);
                    if content.starts_with("ERROR") {
                        set_string("status_message", content);
                    } else {
                        set_f64("selected_index", i);
                        set_string("current_path", script.source_path);
                        set_string("current_content", content);
                        set_bool("is_dirty", false);
                        let path_for_msg = get_string("current_path", "");
                        set_string("status_message", `Loaded ${path_for_msg}`);
                    }
                } else {
                    set_string("status_message", "Inline scripts cannot be edited in this editor.");
                }
                return;
            }
        }
    }

    ui.separator();

    // Editor
    let editor_path = get_string("current_path", "");
    if editor_path != "" {
        ui.label("Editor:");
        let current_content = get_string("current_content", "");
        let new_content = ui.text_edit_multiline("editor_content", current_content, None, Some(500.0));
        set_string("current_content", new_content);

        // Mark as dirty if changed
        let stored_content = get_string("current_content", "");
        if stored_content != current_content {
            set_bool("is_dirty", true);
        }
    } else {
        ui.label("Select a script to edit");
    }
}

fn refresh_script_list() {
    let scripts = get_all_script_entities();
    let count = scripts.len();
    set_string("status_message", `Found ${count} script(s)`);
    set_bool("needs_refresh", false);
}
